{
  "name": "dsh-plugin-extension-center",
  "version": "0.0.0-development",
  "description": "Independent DeepSeek Harness Extension Center for Plugin, MCP connection, and Skill lifecycles",
  "private": true,
  "license": "MIT",
  "author": "striveh",
  "type": "module",
  "sideEffects": [
    "./lib/client.js"
  ],
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./recovery": {
      "types": "./lib/types/recovery/index.d.ts",
      "default": "./lib/recovery/index.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "README.zh.md",
    "docs",
    "acceptance/store-only",
    "acceptance/full-p0",
    "CHANGELOG.md",
    "CONTRIBUTING.md",
    "SECURITY.md",
    "LICENSE"
  ],
  "engines": {
    "node": "^22.19.0 || >=24.0.0",
    "dsh": "0.1.1-rc.2"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-primitives",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-sidebar"
      ]
    }
  },
  "scripts": {
    "clean": "node scripts/clean.mjs",
    "clean:client-build": "node scripts/clean-client-build.mjs",
    "typecheck": "tsc -p tsconfig.host.json --noEmit && tsc -p tsconfig.client.json --noEmit",
    "build": "pnpm run clean && tsc -p tsconfig.host.json && tsc -p tsconfig.client.json && tsdown && pnpm run clean:client-build && node scripts/normalize-build-newlines.mjs",
    "test": "pnpm run build && vitest run && node --test acceptance/store-only/support.test.mjs acceptance/full-p0/support.test.mjs acceptance/full-p0/build-binding.test.mjs acceptance/full-p0/receipt-binding.test.mjs",
    "test:acceptance:store": "pnpm run build && node acceptance/store-only/run.mjs",
    "test:acceptance:host-negative": "pnpm run build && node acceptance/full-p0/verify-host-negative.mjs",
    "test:acceptance:local-head": "pnpm run build && node acceptance/full-p0/verify-local-head.mjs",
    "catalog:discover": "pnpm run build && node scripts/catalog-pipeline.mjs discover",
    "catalog:publish": "pnpm run build && node scripts/catalog-pipeline.mjs publish",
    "pack:preview": "pnpm run build && pnpm pack --dry-run"
  },
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "extension-manager",
    "plugin-manager",
    "mcp",
    "agent-skills",
    "capability-discovery",
    "local-first"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/striveh/dsh-plugin-extension-center.git"
  },
  "bugs": {
    "url": "https://github.com/striveh/dsh-plugin-extension-center/issues"
  },
  "homepage": "https://github.com/striveh/dsh-plugin-extension-center#readme",
  "peerDependencies": {
    "@deepseek-ai/cordis": "4.0.1",
    "@deepseek-ai/dsh-client-connection": "0.1.1-rc.2",
    "@deepseek-ai/dsh-client-locale": "0.1.1-rc.2",
    "@deepseek-ai/dsh-client-runtime": "0.1.1-rc.2",
    "@deepseek-ai/dsh-client-ui-layout": "0.1.1-rc.2",
    "@deepseek-ai/dsh-client-ui-primitives": "0.1.1-rc.2",
    "@deepseek-ai/dsh-client-ui-sidebar": "0.1.1-rc.2",
    "@deepseek-ai/dsh-client-ui-slots": "0.1.1-rc.2",
    "react": "^18.2.0",
    "yaml": "2.9.0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-client-connection": { "optional": true },
    "@deepseek-ai/dsh-client-locale": { "optional": true },
    "@deepseek-ai/dsh-client-runtime": { "optional": true },
    "@deepseek-ai/dsh-client-ui-layout": { "optional": true },
    "@deepseek-ai/dsh-client-ui-primitives": { "optional": true },
    "@deepseek-ai/dsh-client-ui-sidebar": { "optional": true },
    "@deepseek-ai/dsh-client-ui-slots": { "optional": true },
    "react": { "optional": true }
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.1",
    "@deepseek-ai/dsh": "0.1.1-rc.2",
    "@deepseek-ai/dsh-client-connection": "0.1.1-rc.2",
    "@deepseek-ai/dsh-client-locale": "0.1.1-rc.2",
    "@deepseek-ai/dsh-client-runtime": "0.1.1-rc.2",
    "@deepseek-ai/dsh-client-ui-layout": "0.1.1-rc.2",
    "@deepseek-ai/dsh-client-ui-primitives": "0.1.1-rc.2",
    "@deepseek-ai/dsh-client-ui-sidebar": "0.1.1-rc.2",
    "@deepseek-ai/dsh-client-ui-slots": "0.1.1-rc.2",
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^24.13.3",
    "@types/react": "~18.3.1",
    "@types/react-dom": "^18.3.7",
    "jsdom": "^26.1.0",
    "lightningcss": "^1.33.0",
    "playwright": "1.61.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "tsdown": "0.22.2",
    "typescript": "^6.0.3",
    "vitest": "^4.1.8",
    "yaml": "2.9.0"
  },
  "packageManager": "pnpm@11.21.0"
}
